#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&gresc { keep-mods = <(MOD_LSFT|MOD_RSFT)>; };

/ {
    behaviors {

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
        };

        tl: tapping_layers {
            compatible = "zmk,behavior-hold-tap";            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
        };

        lkr: layer_key-repeat {
            compatible = "zmk,behavior-hold-tap";            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        th_Th: th_Th {
            compatible = "zmk,behavior-hold-tap";            bindings = <&mo>, <&Th>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        caps_n_tap: caps_n_tap {
            compatible = "zmk,behavior-hold-tap";            bindings = <&caps_word>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        kr_n_tap: kr_n_tap {
            compatible = "zmk,behavior-hold-tap";            bindings = <&key_repeat>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        u_paste: u_paste {
            compatible = "zmk,behavior-mod-morph";            bindings = <&kp U>, <&kp LC(V)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        layer_u_paste: layer_u_paste {
            compatible = "zmk,behavior-hold-tap";            bindings = <&mo>, <&u_paste>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        w_copy: w_copy {
            compatible = "zmk,behavior-mod-morph";            bindings = <&kp W>, <&kp LC(C)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        layer_w_copy: layer_w_copy {
            compatible = "zmk,behavior-hold-tap";            bindings = <&mo>, <&w_copy>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        j_cut: j_cut {
            compatible = "zmk,behavior-mod-morph";            bindings = <&kp J>, <&kp LC(X)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        o_save: o_save {
            compatible = "zmk,behavior-mod-morph";            bindings = <&kp O>, <&kp LC(S)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mod_o_save: mod_o_save {
            compatible = "zmk,behavior-hold-tap";            bindings = <&kp>, <&o_save>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        the: the {
            compatible = "zmk,behavior-mod-morph";            bindings = <&lthe>, <&uThe>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        from: from {
            compatible = "zmk,behavior-mod-morph";            bindings = <&lfrom>, <&uFrom>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        have: have {
            compatible = "zmk,behavior-mod-morph";            bindings = <&lhave>, <&uHave>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        because: because {
            compatible = "zmk,behavior-mod-morph";            bindings = <&lbecause>, <&uBecause>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        their: their {
            compatible = "zmk,behavior-mod-morph";            bindings = <&ltheir>, <&uTheir>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        there: there {
            compatible = "zmk,behavior-mod-morph";            bindings = <&lthere>, <&uThere>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        theyre: theyre {
            compatible = "zmk,behavior-mod-morph";            bindings = <&ltheyre>, <&uTheyre>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        where: where {
            compatible = "zmk,behavior-mod-morph";            bindings = <&lwhere>, <&uWhere>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        will: will {
            compatible = "zmk,behavior-mod-morph";            bindings = <&lwill>, <&uWill>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        would: would {
            compatible = "zmk,behavior-mod-morph";            bindings = <&uWould>, <&uWould>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aint: aint {
            compatible = "zmk,behavior-mod-morph";            bindings = <&laint>, <&uAint>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        yall: yall {
            compatible = "zmk,behavior-mod-morph";            bindings = <&lyall>, <&uYall>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        shant: shant {
            compatible = "zmk,behavior-mod-morph";            bindings = <&lshant>, <&uShant>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        layer_the: layer_the {
            compatible = "zmk,behavior-hold-tap";            bindings = <&mo>, <&there>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };
    };

    macros {
        ht: ht {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp T>;        };

        double0: double0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;        };

        Th: Th {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H>;        };

        lthe: lthe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp SPACE>;        };

        uThe: uThe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp SPACE>;        };

        lhave: lhave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp A &kp V &kp E &kp SPACE>;        };

        uHave: uHave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(H) &kp A &kp V &kp E &kp SPACE>;        };

        lfrom: lfrom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp R &kp O &kp M &kp SPACE>;        };

        uFrom: uFrom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(F) &kp R &kp O &kp M &kp SPACE>;        };

        lbecause: lbecause {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp E &kp C &kp A &kp U &kp S &kp E &kp SPACE>;        };

        uBecause: uBecause {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(B) &kp E &kp C &kp A &kp U &kp S &kp E &kp SPACE>;        };

        ltheir: ltheir {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp I &kp R &kp SPACE>;        };

        uTheir: uTheir {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp I &kp R &kp SPACE>;        };

        lthere: lthere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp R &kp E &kp SPACE>;        };

        uThere: uThere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp R &kp E &kp SPACE>;        };

        ltheyre: ltheyre {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp Y &kp SQT &kp R &kp E &kp SPACE>;        };

        uTheyre: uTheyre {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp Y &kp SQT &kp R &kp E &kp SPACE>;        };

        lwhere: lwhere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp H &kp E &kp R &kp E &kp SPACE>;        };

        uWhere: uWhere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(W) &kp H &kp E &kp R &kp E &kp SPACE>;        };

        lwill: lwill {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp I &kp L &kp L &kp SPACE>;        };

        uWill: uWill {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(W) &kp I &kp L &kp L &kp SPACE>;        };

        lwould: lwould {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp O &kp U &kp L &kp D &kp SPACE>;        };

        uWould: uWould {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(W) &kp O &kp U &kp L &kp D &kp SPACE>;        };

        laint: laint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp I &kp N &kp SQT &kp T &kp SPACE>;        };

        uAint: uAint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(A) &kp I &kp N &kp SQT &kp T &kp SPACE>;        };

        lyall: lyall {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp SQT &kp A &kp L &kp L &kp SPACE>;        };

        uYall: uYall {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Y) &kp SQT &kp A &kp L &kp L &kp SPACE>;        };

        lshant: lshant {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp A &kp N &kp SQT &kp T &kp SPACE>;        };

        uShant: uShant {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp H &kp A &kp N &kp SQT &kp T &kp SPACE>;            wait-ms = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        hl_period {
            bindings = <&kp PERIOD>;
            key-positions = <32 31>;
        };

        hl_exclam {
            bindings = <&kp EXCLAMATION>;
            key-positions = <32 30>;
        };

        hl_colon {
            bindings = <&kp COLON>;
            key-positions = <32 29>;
        };

        hl_under {
            bindings = <&kp UNDER>;
            key-positions = <31 30>;
        };

        hl_apos {
            bindings = <&kp SQT>;
            key-positions = <30 29>;
        };

        hl_enter {
            bindings = <&kp ENTER>;
            key-positions = <32 31 30>;
        };

        hl_esc {
            bindings = <&gresc>;
            key-positions = <29 30 31>;
        };

        hl_bt-prv {
            bindings = <&bt BT_PRV>;
            key-positions = <29 30 31 32>;
        };

        hr_comma {
            bindings = <&kp COMMA>;
            key-positions = <41 42>;
        };

        hr_question {
            bindings = <&kp QUESTION>;
            key-positions = <41 43>;
        };

        hr_semi {
            bindings = <&kp SEMI>;
            key-positions = <44 41>;
        };

        hr_dash {
            bindings = <&kp MINUS>;
            key-positions = <43 42>;
        };

        hr_enter {
            bindings = <&kp ENTER>;
            key-positions = <43 42 41>;
        };

        hr_esc {
            bindings = <&gresc>;
            key-positions = <42 44 43>;
        };

        hr_bt-nxt {
            bindings = <&bt BT_NXT>;
            key-positions = <44 43 42 41>;
        };

        bl_bspc {
            bindings = <&kp BACKSPACE>;
            key-positions = <49 48>;
        };

        hl_bsl {
            bindings = <&kp BACKSLASH>;
            key-positions = <29 31>;
        };

        hr_slsh {
            bindings = <&kp SLASH>;
            key-positions = <44 42>;
        };

        br_bspc {
            bindings = <&kp BACKSPACE>;
            key-positions = <56 57>;
        };

        tl_paren {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <18 17>;
        };

        tr_paren {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <24 23>;
        };

        tl_brkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 17>;
        };

        tr_brkt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <25 24>;
        };

        tl_brc {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 15>;
        };

        tr_brc {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <25 26>;
        };

        tl_less {
            bindings = <&kp LESS_THAN>;
            key-positions = <18 16>;
        };

        tr_grtr {
            bindings = <&kp GREATER_THAN>;
            key-positions = <23 25>;
        };

        tl_tilde {
            bindings = <&kp TILDE>;
            key-positions = <17 15>;
        };

        tr_pipe {
            bindings = <&kp PIPE>;
            key-positions = <26 24>;
        };

        tl_equal {
            bindings = <&kp EQUAL>;
            key-positions = <18 15>;
        };

        tr_prt-sc {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <23 26>;
        };

        bl_del {
            bindings = <&kp DELETE>;
            key-positions = <48 50>;
        };

        br_del {
            bindings = <&kp DELETE>;
            key-positions = <57 55>;
        };

        bl_tab {
            bindings = <&kp TAB>;
            key-positions = <50 49>;
        };

        br_tab {
            bindings = <&kp TAB>;
            key-positions = <55 56>;
        };

        tl_bt-clr {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <18 17 16 15>;
        };

        tr_cad {
            bindings = <&kp LC(LA(DELETE))>;
            key-positions = <26 25 24 23>;
        };

        bl_alt+f4 {
            bindings = <&kp LA(F4)>;
            key-positions = <49 48 50>;
        };

        br_close-window {
            bindings = <&kp LC(W)>;
            key-positions = <57 56 55>;
        };

        l_key-repeat {
            bindings = <&key_repeat>;
            key-positions = <50 32>;
        };

        r_key-repeat {
            bindings = <&key_repeat>;
            key-positions = <55 41>;
        };

        l_caps-word {
            bindings = <&caps_word>;
            key-positions = <31 17>;
        };

        r_caps-word {
            bindings = <&caps_word>;
            key-positions = <42 24>;
        };

        l_capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <30 16>;
        };

        r_capslock {
            bindings = <&kp CLCK>;
            key-positions = <43 25>;
        };

        l_insert {
            bindings = <&kp INSERT>;
            key-positions = <29 15>;
        };

        r_insert {
            bindings = <&kp INSERT>;
            key-positions = <44 26>;
        };

        th_x {
            bindings = <&tl 13 X>;
            key-positions = <66 65>;
        };

        r_thumbs {
            bindings = <&layer_the 13 0>;
            key-positions = <69 70>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qkly {
            display-name = "Base";
            bindings = <
&tog 1  &none           &none                   &none               &none                &none  &none                                                            &none        &none  &none              &none                &none            &none            &tog 1
&none   &hm LEFT_GUI Q  &hm RIGHT_ALT K         &tl 15 L            &kp Y                &none  &sys_reset                                                       &sys_reset   &none  &mt PRINTSCREEN G  &tl 15 C             &hm RIGHT_ALT P  &hm RIGHT_GUI Z  &none
&none   &tl 7 I         &mod_o_save LEFT_ALT 0  &hm LEFT_CONTROL R  &hm LEFT_SHIFT E     &none  &bootloader  &none        &none            &none        &none    &bootloader  &none  &hm RIGHT_SHIFT S  &hm RIGHT_CONTROL D  &hm LEFT_ALT N   &tl 8 A          &none
&none   &none           &j_cut                  &layer_w_copy 9 0   &layer_u_paste 13 0  &none                            &none            &none                              &none  &tl 13 F           &lt 10 M             &kp B            &none            &none
&tog 2  &none           &none                   &none               &none                       &tl 5 V      &tl 3 SPACE  &key_repeat      &key_repeat  &tl 4 T  &tl 6 H             &none              &none                &none            &none            &tog 2
            >;
        };

        resend {
            display-name = "Base";
            bindings = <
&tog 1  &none            &none            &none               &none             &none  &none                                                     &none        &none  &none              &none                &none            &none            &tog 1
&none   &kp Q            &hm RIGHT_ALT Y  &lt 9 G             &kp W             &none  &sys_reset                                                &sys_reset   &none  &kp P              &tl 10 L             &hm RIGHT_ALT F  &kp Z            &none
&none   &hm LEFT_META A  &hm LEFT_ALT I   &hm LEFT_CONTROL O  &hm LEFT_SHIFT E  &none  &bootloader  &none        &none        &none     &none    &bootloader  &none  &hm RIGHT_SHIFT D  &hm RIGHT_CONTROL N  &hm LEFT_ALT S   &hm RIGHT_GUI R  &none
&none   &none            &kp J            &kp W               &tl 13 U          &none                            &none        &none                           &none  &tl 13 C           &kp M                &kp B            &none            &none
&none   &none            &none            &none               &none                    &tl 5 V      &tl 3 SPACE  &tl 7 X      &lkr 0 0  &tl 4 T  &tl 6 H             &none              &none                &none            &none            &none
            >;
        };

        qwerty {
            display-name = "Base";
            bindings = <
&kp EQUAL         &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                    &none      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB           &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&hm LCTRL ESCAPE  &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT         &none      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&tog 2            &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &tog 2
            >;
        };

        num_l {
            display-name = "num_l";
            bindings = <
&none  &none                 &none   &none   &none   &none  &none                                     &none   &none  &none         &none   &none   &none                  &none
&none  &mt LEFT_SHIFT MINUS  &kp N7  &kp N8  &kp N9  &none  &none                                     &none   &none  &kp N7        &kp N8  &kp N9  &mt RIGHT_SHIFT EQUAL  &none
&none  &kp N0                &kp N4  &kp N5  &kp N6  &none  &none   &none   &none      &none  &none   &none   &none  &kp NUMBER_4  &kp N5  &kp N6  &kp N0                 &none
&none  &none                 &kp N1  &kp N2  &kp N3  &none                  &none      &none                  &none  &kp NUMBER_1  &kp N2  &kp N3  &none                  &none
&none  &none                 &none   &none   &none          &trans  &trans  &none      &none  &trans  &trans         &none         &none   &none   &none                  &none
            >;
        };

        num_r {
            display-name = "num_r";
            bindings = <
&none  &none             &none   &none   &none   &none  &none                                     &none   &none  &none         &none   &none   &none             &none
&none  &mt LSHIFT MINUS  &kp N7  &kp N8  &kp N9  &none  &none                                     &none   &none  &kp N7        &kp N8  &kp N9  &mt RSHIFT EQUAL  &none
&none  &kp N0            &kp N4  &kp N5  &kp N6  &none  &none   &none   &none      &none  &none   &none   &none  &kp NUMBER_4  &kp N5  &kp N6  &kp N0            &none
&none  &none             &kp N1  &kp N2  &kp N3  &none                  &none      &none                  &none  &kp NUMBER_1  &kp N2  &kp N3  &none             &none
&none  &none             &none   &none   &none          &trans  &trans  &none      &none  &trans  &trans         &none         &none   &none   &none             &none
            >;
        };

        nav_l {
            bindings = <
&none  &none              &none               &none                   &none               &none  &none                                     &none   &none  &none                 &none                    &none                   &none              &none
&none  &hm LEFT_GUI HOME  &hm LEFT_ALT PG_DN  &hm LEFT_CONTROL PG_UP  &hm LEFT_SHIFT END  &none  &none                                     &none   &none  &hm RIGHT_SHIFT HOME  &hm RIGHT_CONTROL PG_UP  &hm LEFT_ALT PAGE_DOWN  &hm RIGHT_GUI END  &none
&none  &kp LEFT           &kp DOWN            &kp UP                  &kp RIGHT           &none  &none   &none   &none      &none  &none   &none   &none  &kp LEFT              &kp UP                   &kp DOWN                &kp RIGHT          &none
&none  &none              &kp LEFT            &kp DOWN                &kp RIGHT           &none                  &none      &none                  &none  &kp LEFT              &kp DOWN                 &kp RIGHT               &none              &none
&none  &none              &none               &none                   &none                      &trans  &trans  &none      &none  &trans  &trans         &none                 &none                    &none                   &none              &none
            >;
        };

        nav_r {
            bindings = <
