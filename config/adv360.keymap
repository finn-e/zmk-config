#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>

// BOUGIE KEYS
// LEFT SIDE
#define TLP 47
#define TLR 48
#define TLM 49
#define TLI 50
#define BLP 61
#define BLR 62
#define BLM 63
#define BLI 64
#define LIT 65
#define LOT 66
// RIGHT SIDE
#define TRP 58
#define TRR 57
#define TRM 56
#define TRI 55
#define BRP 74
#define BRR 73
#define BRM 72
#define BRI 71
#define ROT 69
#define RIT 70
// LAYERS
#define DEF  0
#define NAV  1
#define DESK  2
#define WIN  3
#define NUM  4
#define BT   5
// CONFIG
#define COMBO_TIMEOUT 70
#define COMBO_LAYERS DEF NAV DESK WIN NUM BT
#define STICKY_TIMEOUT 1000
#define HOLD_TAP_TIMEOUT 190
// BEHAVIOR REDEFINITIONS
&sk {
    release-after-ms = <STICKY_TIMEOUT>;
    quick-release;
    /delete-property/ ignore-modifiers;
};
&sl {
    release-after-ms = <STICKY_TIMEOUT>;
    quick-release;
    /delete-property/ ignore-modifiers;
};

/ {
    behaviors {
        #include "behaviors.dtsi"
    };

    macros {
        #include "macros.dtsi"
    };

    backlight {
        compatible = "zmk,backlight";
    };

    combos {
        compatible = "zmk,combos";
        #include "combos.dtsi"
    };

    keymap {
        compatible = "zmk,keymap";

        lic {
            display-name = "lic";
            bindings = <
&bt BT_CLR &bt BT_SEL 0       &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR      &sys_reset                                                               &sys_reset   &bt BT_CLR      &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0       &bt BT_CLR
&none      &sk_lalt_lock      &as l        &as i        &as c        &none           &sys_reset                                                               &sys_reset   &none           &as c        &as i        &as l        &sk_lalt_lock      &none
&none      &sk_lctrl_lock     &as r        &as o        &as d        &rgb_ug RGB_TOG &bootloader    &none          &none            &none  &none              &bootloader  &rgb_ug RGB_TOG &as d        &as o        &as r        &sk_lctrl_lock     &none
&none      &sk_lshift_lock    &as n        &as e        &as t        &out OUT_TOG                                  &none            &none                                  &out OUT_TOG    &as t        &as e        &as n        &sk_lshift_lock    &none
&none      &sk_lgui_lock      &as h        &as a        &as s                        &lt NAV SPC    &lt DESK BSPC  &none            &none  &lt DESK BSPC      &lt NAV SPC                  &as s        &as a        &as h        &sk_lgui_lock      &none
            >;
        };

        navigation {
            display-name = "nav";
            bindings = <
&none  &none     &none      &none      &none      &none  &none                                     &none   &none  &none     &none      &none      &none      &none
&none  &none     &none      &none      &none      &none  &none                                     &none   &none  &none     &none      &none      &none      &none
&none  &none     &none      &none      &none      &none  &none   &none   &none      &none  &none   &none   &none  &none     &none      &none      &none      &none
&none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none                  &none      &none                  &none  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END    &none
&none  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT         &trans  &trans  &none      &none  &trans  &trans         &kp LEFT  &kp UP     &kp DOWN   &kp RIGHT  &none
            >;
        };


        desktop {
            display-name = "dsk";
            bindings = <
&none  &none             &none             &none           &none                &none   &none                                &none   &none  &none             &none           &none             &none              &none
&none  &none             &none             &none           &none                &none   &none                                &none   &none  &none             &none           &none             &none              &none
&none  &kp LS(LG(LEFT))  &kp LS(LG(DOWN))  &kp LS(LG(UP))  &kp LS(LG(RIGHT))    &none   &none   &none  &none  &none  &none   &none   &none  &kp LS(LG(LEFT))  &kp LS(LG(UP))  &kp LS(LG(DOWN))  &kp LS(LG(RIGHT))  &none
&none  &kp LG(LEFT)      &kp LG(DOWN)      &kp LG(UP)      &kp LG(RIGHT)        &none                  &none  &none                  &none  &kp LG(LEFT)      &kp LG(UP)      &kp LG(DOWN)      &kp LG(RIGHT)      &none
&none  &none             &none             &none           &none                        &trans  &trans &none  &none  &trans  &trans         &none             &none           &none             &none              &none
            >;
        };

        window {
            display-name = "win";
            bindings = <
&none  &none                  &none                  &none                &none                  &none  &none                                     &none   &none  &none                 &none               &none                 &none                  &none
&none  &none                  &none                  &none                &none                  &none  &none                                     &none   &none  &none                 &none               &none                 &none                  &none
&none  &kp LS(LC(LG(LEFT)))   &kp LS(LC(LG(DOWN)))   &kp LS(LC(LG(UP)))   &kp LS(LC(LG(RIGHT)))  &none  &none   &none   &none      &none  &none   &none   &none  &kp LS(LC(LG(LEFT)))  &kp LS(LC(LG(UP)))  &kp LS(LC(LG(DOWN)))  &kp LS(LC(LG(RIGHT)))  &none
&none  &kp LC(LG(LEFT))       &kp LC(LG(DOWN))       &kp LC(LG(UP))       &kp LC(LG(RIGHT))      &none                  &none      &none                  &none  &kp LC(LG(LEFT))      &kp LC(LG(UP))      &kp LC(LG(DOWN))      &kp LC(LG(RIGHT))      &none
&none  &none                  &none                  &none                &none                         &trans  &trans  &none      &none  &trans  &trans         &none                 &none               &none                 &none                  &none
            >;
        };

        numbers {
            display-name = "num";
            bindings = <
&none  &none   &none   &none   &none   &none  &none                                     &none   &none  &none   &none   &none   &none   &none
&none  &none   &none   &none   &none   &none  &none                                     &none   &none  &none   &none   &none   &none   &none
&none  &as N6  &as N5  &as N4  &as N3  &none  &none   &none   &none      &none  &none   &none   &none  &as N3  &as N4  &as N5  &as N6  &none
&none  &as N7  &as N2  &as N1  &as N0  &none                  &none      &none                  &none  &as N0  &as N1  &as N2  &as N7  &none
&none  &none   &none   &none   &none          &as N8  &as N9  &none      &none  &as N9  &as N8         &none   &none   &none   &none   &none
            >;
        };

        bt {
            display-name = "bt";
            bindings = <
&none  &none         &none         &none         &none         &none  &none                                     &none   &none  &none         &none         &none         &none         &none
&none  &none         &none         &none         &none         &none  &none                                     &none   &none  &none         &none         &none         &none         &none
&none  &bt BT_SEL 4  &bt BT_PRV    &bt BT_NXT    &bt BT_CLR    &none  &none   &none   &none      &none  &none   &none   &none  &bt BT_CLR    &bt BT_NXT    &bt BT_PRV    &bt BT_SEL 4  &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none                  &none      &none                  &none  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none  &none         &none         &none         &none                &trans  &trans  &none      &none  &trans  &trans         &none         &none         &none         &none         &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        WIN {
            if-layers = <NAV DESK>;
            then-layer = <WIN>;
        };
    };
};
