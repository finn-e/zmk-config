#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>

// BOUGIE KEYS
// LEFT SIDE
#define TLP 29
#define TLR 30
#define TLM 31
#define TLI 32
#define BLP 47
#define BLR 48
#define BLM 49
#define BLI 50
#define LIT 65
#define LOT 66
// RIGHT SIDE
#define TRP 44
#define TRR 43
#define TRM 42
#define TRI 41
#define BRP 58
#define BRR 57
#define BRM 56
#define BRI 55
#define ROT 69
#define RIT 70
// LAYERS
#define DEF  0
#define QWE  1
#define NAV  2
#define DESK  3
#define WIN  4
#define NUM  5
#define BT   6
// CONFIG
#define COMBO_TIMEOUT 70
#define COMBO_LAYERS DEF NAV DESK WIN NUM BT
#define STICKY_TIMEOUT 1000
#define HOLD_TAP_TIMEOUT 190
// BEHAVIOR REDEFINITIONS
&sk {
    release-after-ms = <STICKY_TIMEOUT>;
    quick-release;
    /delete-property/ ignore-modifiers;
};
&sl {
    release-after-ms = <STICKY_TIMEOUT>;
    quick-release;
    /delete-property/ ignore-modifiers;
};

/ {
    behaviors {
        #include "behaviors.dtsi"
    };

    macros {
        #include "macros.dtsi"
    };

    backlight {
        compatible = "zmk,backlight";
    };

    combos {
        compatible = "zmk,combos";
        #include "combos.dtsi"
    };

    keymap {
        compatible = "zmk,keymap";

        bougie {
            display-name = "bou";
            bindings = <
&none   &none        &none  &none  &none  &none  &tog QWE                                                                 &tog QWE     &none  &none  &none  &none  &none        &none
&none   &none        &none  &none  &none  &none  &sys_reset                                                               &sys_reset   &none  &none  &none  &none  &none        &none
&none   &tabdance    &as I  &as O  &as N  &none                              &none            &none                                    &none  &as N  &as O  &as I  &tabdance    &none
&none   &key_repeat  &as E  &as A  &as T  &none  &bootloader  &none          &none            &none        &none          &bootloader  &none  &as T  &as A  &as E  &key_repeat  &none
&none   &none        &none  &none  &none         &none        &lt DESK BSPC  &lt NAV SPC      &lt NAV SPC  &lt DESK BSPC  &none        &none  &none  &none  &none  &none        &none
            >;
        };

        qwerty {
            display-name = "qwe";
            bindings = <
&kp EQUAL         &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &trans     &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB           &kp Q      &kp W     &kp E     &kp R      &kp T   &trans                                                   &trans     &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&mt LCTRL ESCAPE  &kp A      &kp S     &kp D     &kp F      &kp G   &trans    &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &trans     &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT         &none      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&none             &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &none
            >;
        };

        navigation {
            display-name = "nav";
            bindings = <
&none  &none     &none      &none      &none      &none  &none                                     &none   &none  &none     &none      &none      &none      &none
&none  &none     &none      &none      &none      &none  &none                                     &none   &none  &none     &none      &none      &none      &none
&none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none                  &none      &none                  &none  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END    &none
&none  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &none  &none   &none   &none      &none  &none   &none   &none  &kp LEFT  &kp UP     &kp DOWN   &kp RIGHT  &none
&none  &none     &none      &none      &none             &trans  &trans  &none      &none  &trans  &trans         &none     &none      &none      &none      &none
            >;
        };


        desktop {
            display-name = "dsk";
            bindings = <
&none  &none             &none             &none           &none                &none   &none                                &none   &none  &none             &none           &none             &none              &none
&none  &none             &none             &none           &none                &none   &none                                &none   &none  &none             &none           &none             &none              &none
&none  &kp LS(LG(LEFT))  &kp LS(LG(DOWN))  &kp LS(LG(UP))  &kp LS(LG(RIGHT))    &none                  &none  &none                  &none  &kp LS(LG(LEFT))  &kp LS(LG(UP))  &kp LS(LG(DOWN))  &kp LS(LG(RIGHT))  &none
&none  &kp LG(LEFT)      &kp LG(DOWN)      &kp LG(UP)      &kp LG(RIGHT)        &none   &none   &none  &none  &none  &none   &none   &none  &kp LG(LEFT)      &kp LG(UP)      &kp LG(DOWN)      &kp LG(RIGHT)      &none
&none  &none             &none             &none           &none                        &trans  &trans &none  &none  &trans  &trans         &none             &none           &none             &none              &none
            >;
        };

        window {
            display-name = "win";
            bindings = <
&none  &none                  &none                  &none                &none                  &none  &none                                     &none   &none  &none                 &none               &none                 &none                  &none
&none  &none                  &none                  &none                &none                  &none  &none                                     &none   &none  &none                 &none               &none                 &none                  &none
&none  &kp LS(LC(LG(LEFT)))   &kp LS(LC(LG(DOWN)))   &kp LS(LC(LG(UP)))   &kp LS(LC(LG(RIGHT)))  &none                  &none      &none                  &none  &kp LS(LC(LG(LEFT)))  &kp LS(LC(LG(UP)))  &kp LS(LC(LG(DOWN)))  &kp LS(LC(LG(RIGHT)))  &none
&none  &kp LC(LG(LEFT))       &kp LC(LG(DOWN))       &kp LC(LG(UP))       &kp LC(LG(RIGHT))      &none  &none   &none   &none      &none  &none   &none   &none  &kp LC(LG(LEFT))      &kp LC(LG(UP))      &kp LC(LG(DOWN))      &kp LC(LG(RIGHT))      &none
&none  &none                  &none                  &none                &none                         &trans  &trans  &none      &none  &trans  &trans         &none                 &none               &none                 &none                  &none
            >;
        };

        numbers {
            display-name = "num";
            bindings = <
&none  &none   &none   &none   &none   &none  &none                                     &none   &none  &none   &none   &none   &none   &none
&none  &none   &none   &none   &none   &none  &none                                     &none   &none  &none   &none   &none   &none   &none
&none  &as N6  &as N5  &as N4  &as N3  &none                  &none      &none                  &none  &as N3  &as N4  &as N5  &as N6  &none
&none  &as N7  &as N2  &as N1  &as N0  &none  &none   &none   &none      &none  &none   &none   &none  &as N0  &as N1  &as N2  &as N7  &none
&none  &none   &none   &none   &none          &as N8  &as N9  &none      &none  &as N9  &as N8         &none   &none   &none   &none   &none
            >;
        };

        bt {
            display-name = "bt";
            bindings = <
&none  &none         &none         &none         &none         &none  &none                                     &none   &none  &none         &none         &none         &none         &none
&none  &none         &none         &none         &none         &none  &none                                     &none   &none  &none         &none         &none         &none         &none
&none  &bt BT_SEL 4  &bt BT_PRV    &bt BT_NXT    &bt BT_CLR    &none                  &none      &none                  &none  &bt BT_CLR    &bt BT_NXT    &bt BT_PRV    &bt BT_SEL 4  &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none  &none   &none   &none      &none  &none   &none   &none  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none  &none         &none         &none         &none                &trans  &trans  &none      &none  &trans  &trans         &none         &none         &none         &none         &none
            >;
        };
    };
    
    conditional_layers {
        compatible = "zmk,conditional-layers";
        WIN {
            if-layers = <NAV DESK>;
            then-layer = <WIN>;
        };
    };
};
