#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define FUNC    1
#define MISC    2
#define FOURTH  3

/{
    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "QWERTY";
            bindings = <
                &gresc   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                              &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC    
                &kp TAB  &kp Q     &kp W     &kp E     &kp R     &kp T                               &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH
                &kp CAPS &kp A     &kp S     &kp D     &kp F     &kp G                               &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp APOS  &kp RET   &sl MISC
                &kp LSFT &kp Z     &kp X     &kp C     &kp V     &kp B                               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSFT  &kp UP    &sl FUNC
                &kp LCTRL    &kp LALT  &kp LMETA       &kp SPACE                                     &kp SPACE     &kp RMETA     &kp RALT  &kp RCTRL   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };    
        func {
            display-name = "FUNCTIONS";
            bindings = <
                &gresc   &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                              &kp F6    &kp F7    &kp F8    &kp F9    &kp F0    &kp MINUS &kp EQUAL &kp DEL    
                &kp TAB  &kp Q     &kp W     &kp E     &kp R     &kp T                               &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH
                &kp CAPS &kp A     &kp S     &kp D     &kp F     &kp G                               &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp APOS  &kp RET   &sl MISC
                &kp LSFT &kp Z     &kp X     &kp C     &kp V     &kp B                               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSFT  &kp UP    &sl FUNC
                &kp LCTRL    &kp LALT  &kp LMETA       &kp SPACE                                     &kp SPACE     &kp RMETA     &kp RALT  &kp RCTRL   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };    
        misc {
            display-name = "MISC";
            bindings = <
                &gresc   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                              &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC    
                &kp TAB  &kp Q     &kp W     &kp E     &kp R     &kp T                               &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH
                &kp CAPS &kp A     &kp S     &kp D     &kp F     &kp G                               &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp APOS  &kp RET   &sl MISC
                &kp LSFT &kp Z     &kp X     &kp C     &kp V     &kp B                               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSFT  &kp UP    &sl FUNC
                &kp LCTRL    &kp LALT  &kp LMETA       &kp SPACE                                     &kp SPACE     &kp RMETA     &kp RALT  &kp RCTRL   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };    
        fourth {
            display-name = "FOURTH";
            bindings = <
                &gresc   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                              &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC    
                &kp TAB  &kp Q     &kp W     &kp E     &kp R     &kp T                               &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH
                &kp CAPS &kp A     &kp S     &kp D     &kp F     &kp G                               &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp APOS  &kp RET   &sl MISC
                &kp LSFT &kp Z     &kp X     &kp C     &kp V     &kp B                               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSFT  &kp UP    &sl FUNC
                &kp LCTRL    &kp LALT  &kp LMETA       &kp SPACE                                     &kp SPACE     &kp RMETA     &kp RALT  &kp RCTRL   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };    

   };
};

