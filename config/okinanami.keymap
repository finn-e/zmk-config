#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp TAB    &kp Q     &kp W     &kp E      &kp R           &kp T      &kp Y      &kp U   &kp I      &kp O    &kp P     &kp BSPC
&kp ESC    &kp A     &kp S     &kp D      &rgb_ug RGB_ON  &kp G      &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V           &kp B      &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RET
&mo 1      &kp LGUI  &kp LALT  &kp LCTRL  &kp N1          &kp SPACE  &kp MINUS  &kp N2  &kp LEFT   &kp UP   &kp DOWN  &kp RIGHT
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans           &trans           &trans           &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_ON  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans           &trans           &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans           &trans           &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
